# 本地默认值即可跑通；端口特意错开项目 A（短链服务 5432/6379）
DATABASE_URL=postgresql+psycopg2://slot:slot@127.0.0.1:5544/slot_booking
REDIS_URL=redis://127.0.0.1:6390/0

ENV=dev
LOG_LEVEL=INFO

# 业务规则
HOLD_MINUTES=15
MAX_ADVANCE_DAYS=30
SLOT_MINUTES=30

# 后台任务
EXPIRY_WORKER_ENABLED=true
EXPIRY_POLL_INTERVAL=1.0
EXPIRY_BATCH_SIZE=100
EXPIRY_SWEEP_ENABLED=true

# 压测对照组开关：true 时退化成「先 SELECT 查冲突再 INSERT」，用来复现超卖
RISKY_CHECK_ONLY=false
